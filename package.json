{
  "name": "typslug",
  "displayName": "Typslug",
  "publisher": "wasd314",
  "description": "Assisting with note-taking in Typst",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "typst",
    "typ",
    "note",
    "note-taking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wasd314/typslug-vscode.git"
  },
  "activationEvents": [
    "onLanguage:typst"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "typslug.jumpToNote",
        "title": "Typslug: Jump to Note",
        "enablement": "workspaceFolderCount > 0"
      }
    ],
    "configuration": {
      "title": "Typslug",
      "properties": {
        "typslug.entryFileName": {
          "description": "File name recognized as an entry point.",
          "type": "string",
          "default": "main.typ"
        },
        "typslug.triggeringFunctionName": {
          "description": "The name of the function that takes a slug as an argument.",
          "type": "string",
          "default": "scrap"
        },
        "typslug.slugRootPath": {
          "description": "Relative path to the root of slugs from the workspace root folder.",
          "type": "string",
          "default": ""
        },
        "typslug.templateFilePath": {
          "description": "Relative path to the template file from the workspace root folder.",
          "type": "string",
          "default": ".typslug/template.typ"
        }
      }
    }
  },
  "extensionDependencies": [
    "myriad-dreamin.tinymist"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run check",
    "check": "biome check --write",
    "format": "biome format --write",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "arkregex": "^0.0.6",
    "date-fns": "^4.4.0"
  }
}
