{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"style": {
				"useBlockStatements": "warn",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"requireAscii": false,
						"conventions": [
							{
								"selector": {
									"kind": "importNamespace"
								},
								"formats": [
									"camelCase",
									"PascalCase"
								]
							},
							{
								"selector": {
									"kind": "importAlias"
								},
								"formats": [
									"camelCase",
									"PascalCase"
								]
							}
						]
					}
				},
				"useThrowOnlyError": "warn"
			},
			"suspicious": {
				"noDoubleEquals": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"globals": []
	},
	"overrides": [
		{
			"includes": [
				"**/*.ts"
			]
		},
		{
			"includes": [
				"**/*.ts"
			]
		},
		{
			"includes": [
				"**/*.ts"
			]
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}